# .env.sample — variable NAMES only, NO real values (the GitHub repo is PUBLIC).
# For each var: what it's for + where the real value is set (Render backend env or Vercel frontend env).
# Verified against the code (grep os.getenv( in the backend, import.meta.env. in the frontend) on 2026-08-01.
# CORRECTED from an earlier draft: VAPID_PRIVATE_KEY -> VAPID_PRIVATE_KEY_B64 (wrong name),
# VAPID_PUBLIC_KEY removed from backend (never read server-side — it's frontend-only),
# ALLOWED_ORIGINS added (was missing), VITE_VAPID_PUBLIC_KEY added (was missing).

# ── Backend (set in Render env) ─────────────────────────────
SUPABASE_URL=                 # Supabase project URL (https://<ref>.supabase.co)
SUPABASE_SECRET_KEY=          # Supabase secret key (sb_secret_...) — bypasses RLS; server-only
GOOGLE_API_KEY=               # Gemini API key (extraction + agent)
GOOGLE_OAUTH_CLIENT_ID=       # Google OAuth client id (same client as Supabase Google provider; used for Calendar token refresh)
GOOGLE_OAUTH_CLIENT_SECRET=   # Google OAuth client secret (same value as configured in Supabase Google provider)
HOSTAWAY_CLIENT_ID=           # Hostaway API client id
HOSTAWAY_CLIENT_SECRET=       # Hostaway API client secret
SCHEDULER_SECRET=             # shared secret guarding /notifications/run-scheduler (cron-job.org sends it)
VAPID_PRIVATE_KEY_B64=        # Web Push VAPID private key, BASE64-ENCODED PEM (services.py decodes it at runtime; a raw multi-line PEM is not accepted)
VAPID_CONTACT_EMAIL=          # mailto: contact for VAPID claims
ALLOWED_ORIGINS=              # comma-separated CORS allow-list (main.py); defaults to localhost:3000,localhost:5173 if unset — set this in production
AIRTABLE_TOKEN=               # LEGACY — only read by migrate_to_supabase.py (the one-off historical migration script), not by the live app. Flagged for removal (see BACKLOG cleanup)

# ── Frontend (set in Vercel env) ────────────────────────────
VITE_SUPABASE_URL=            # same Supabase project URL, exposed to the browser
VITE_SUPABASE_PUBLISHABLE_KEY=# Supabase publishable key (sb_publishable_...) — safe for the browser
VITE_API_URL=                 # base URL of the Render backend
VITE_VAPID_PUBLIC_KEY=        # Web Push VAPID public key (utils/notifications.js) — safe for the browser, pairs with the backend's VAPID_PRIVATE_KEY_B64
